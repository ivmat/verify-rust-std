+// Optional representation regression tests; expectations may change across Rust versions.
+#[test]
+fn socket_v4_debug_snapshot() {
+    assert_eq!(
+        format!("{:?}", SocketAddrV4::new(Ipv4Addr::new(18, 52, 86, 120), 1234)),
+        "18.52.86.120:1234"
+    );
+}
+
+#[test]
+fn socket_v6_debug_snapshot() {
+    assert_eq!(
+        format!("{:?}", SocketAddrV6::new(Ipv6Addr::new(1, 2, 3, 4, 5, 6, 7, 8), 1234, 42, 7)),
+        "[1:2:3:4:5:6:7:8%7]:1234"
+    );
+}
+
+#[test]
+fn socket_addr_debug_snapshot() {
+    assert_eq!(
+        format!("{:?}", SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::new(18, 52, 86, 120), 1234))),
+        "18.52.86.120:1234"
