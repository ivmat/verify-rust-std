+// Optional representation regression tests; expectations may change across Rust versions.
+#[test]
+fn ipv4_debug_snapshot() {
+    assert_eq!(format!("{:?}", Ipv4Addr::new(18, 52, 86, 120)), "18.52.86.120");
+}
+
+#[test]
+fn ip_addr_debug_snapshot() {
+    assert_eq!(format!("{:?}", IpAddr::V4(Ipv4Addr::new(18, 52, 86, 120))), "18.52.86.120");
